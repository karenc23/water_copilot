# MongoDB (Atlas recommended for the vector-search index)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="chena_copilot"

# Luminal Cloud (DeepSeek / GLM) — self-improving agent track
LUMINAL_API_KEY=""
LUMINAL_BASE_URL="https://api.luminal.ai/v1"
LUMINAL_CHAT_MODEL="deepseek-chat"
LUMINAL_CRITIC_MODEL="glm-4-flash"
LUMINAL_EMBED_MODEL="text-embedding-3-small"

# Set to "true" to run agents without network (offline/AGI track).
# Uses deterministic local fallbacks instead of calling Luminal.
OFFLINE_MODE="false"
